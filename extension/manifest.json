{
  "manifest_version": 2,
  "name": "YouTube Restrictor",
  "version": "0.1.0",
  "description": "Personal self-control tool: detects YouTube playback (native pages and third-party embeds) and blocks it against an owner-defined blocklist.",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": [
        "src/notify/console-log.js",
        "src/match/test-blocklist.js",
        "src/match/blocklist.js",
        "src/block/placeholder.js",
        "src/block/block.js",
        "src/controller.js",
        "src/detect/youtube-native.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": [
        "src/notify/console-log.js",
        "src/match/test-blocklist.js",
        "src/match/blocklist.js",
        "src/block/placeholder.js",
        "src/block/block.js",
        "src/controller.js",
        "src/detect/embed-scan.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "src/messaging/native-client.js",
      "src/messaging/oembed-resolver.js",
      "src/background.js"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "https://www.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-restrictor@stage-ria.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
