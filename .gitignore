# macOS
.DS_Store

# Environment / secrets — never commit real config
.env
.env.*
!.env.example

# Real blocklist data — only blocklist.example.json is committed
shared/blocklist.json
menubar-app/blocklist.json
*.blocklist.json
!shared/blocklist.example.json

# Node (native-host, build tooling)
node_modules/
npm-debug.log*

# Machine-specific, generated by scripts/install-native-host.sh /
# scripts/install-native-host-chrome.sh
native-host/manifest/run-host.sh

# extension-firefox/src/, extension-chrome/src/, and extension-safari/src/
# are generated by scripts/sync-shared-extension-sources.sh from shared/ —
# shared/ is the only committed source of truth, never these copies.
extension-firefox/src/
extension-chrome/src/
extension-safari/src/

# Extension build output
extension-firefox/web-ext-artifacts/
extension-firefox/build/
extension-firefox/*.zip
extension-firefox/*.xpi
extension-chrome/build/
extension-chrome/*.zip
extension-chrome/*.crx

# Xcode / Swift
menubar-app/**/DerivedData/
menubar-app/**/*.xcarchive
menubar-app/**/build/
menubar-app/**/.build/
menubar-app/**/*.xcuserstate
menubar-app/**/xcuserdata/
menubar-app/**/.swiftpm/

# menubar-app/YTRestrictor.xcodeproj, and the .entitlements files under
# menubar-app/, are generated deterministically from menubar-app/
# project.yml by `xcodegen generate` (scripts/generate-xcode-project.sh)
# — project.yml is the committed source of truth, never the .xcodeproj
# or .entitlements files themselves (same "generated, never hand-edited"
# rule as the extension src/ copies above).
menubar-app/YTRestrictor.xcodeproj/
menubar-app/*.entitlements
menubar-app/SafariExtension/*.entitlements

# Editor
.vscode/
.idea/
